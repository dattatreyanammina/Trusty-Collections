rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lakshmi@admin.com'
        ||
        request.auth.token.email == 'dattatreya_nammina@srmap.edu.in'
        ||
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
      );
    }


    // =====================================================
    // PRODUCTS
    // =====================================================

    match /products/{productId} {

      // Anyone can view products
      allow read: if true;

      // Only admins can create products
      allow create: if isAdmin();

      // Only admins can edit products
      allow update: if isAdmin();

      // Only admins can delete products
      allow delete: if isAdmin();
    }


    // =====================================================
    // ORDERS
    // =====================================================

    match /orders/{orderId} {

      // Anyone who knows the order document ID can read it
      allow get: if true;

      // Admin can list all orders
      allow list: if isAdmin();

      // Customers can create orders
      allow create: if
        request.resource.data.status == 'Pending';

      // Admin can update anything.
      // Customer can only add payment information while Pending.
      allow update: if
        isAdmin()
        ||
        (
          resource.data.status == 'Pending'
          &&
          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'transactionId',
              'paymentScreenshot',
              'updatedAt'
            ])
        );

      // Only admin can delete orders
      allow delete: if isAdmin();
    }


    // =====================================================
    // CONFIG
    // =====================================================

    match /config/{configId} {

      // Public config can be read
      allow read: if true;

      // Only admins can change config
      allow create, update, delete: if isAdmin();
    }


    // =====================================================
    // ADMIN RECORDS
    // =====================================================

    match /admins/{uid} {

      // User can check their own admin record
      allow get: if isSignedIn()
                 && request.auth.uid == uid;

      // Admins can list admin records
      allow list: if isAdmin();

      // Prevent frontend from creating admin accounts
      allow create, update, delete: if false;
    }


    // =====================================================
    // DEFAULT DENY
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}